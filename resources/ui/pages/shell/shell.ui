<?xml version="1.0" encoding="UTF-8"?>
<interface domain="material-blur@SakibShahariar.github.io">
  <template class="MaterialBlurShellPage" parent="AdwPreferencesPage">
    <property name="name">shell</property>
    <property name="title" translatable="yes">Shell</property>
    <property name="icon-name">overview-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Desktop</property>
        <child>
          <object class="ComponentRow" id="panel_row">
            <property name="icon">bottom-panel-symbolic</property>
            <property name="title" translatable="yes">Panel</property>
            <property name="subtitle" translatable="yes">The top bar, or the panels from Dash to Panel</property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
